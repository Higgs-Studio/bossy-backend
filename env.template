# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Twilio Configuration (for WhatsApp integration)
# ============================================================================
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ============================================================================
# API Security
# ============================================================================
# Generate a random secret key for API authentication
# You can use: python -c "import secrets; print(secrets.token_urlsafe(32))"
MY_API_SECRET=your_random_secret_key_here

# ============================================================================
# DeepSeek API Configuration
# ============================================================================
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this file: cp env.template .env
# 2. Fill in all the values above
# 3. Never commit .env to git (it's in .gitignore)
# 4. Verify with: python -c "from dotenv import load_dotenv; load_dotenv(); import os; print('OK' if os.getenv('SUPABASE_URL') else 'Missing vars')"

